filters:
  and:
    - file.inFolder("Markdown")
formulas:
  name_length: file.name.length
  broken: file.name.notAFunction()
properties:
  file.name:
    displayName: Name
views:
  - type: table
    name: Table view
    order:
      - file.name
      - file.folder
      - tags
      - formula.name_length
      - formula.broken
      - file.mtime
    sort:
      - property: file.name
        direction: ASC
    summaries:
      formula.name_length: Average
  - type: cards
    name: Cards view
    order:
      - file.name
      - tags
  - type: list
    name: List view
    order:
      - file.name
      - file.folder
      - tags
  - type: kanban
    name: Board
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - tags
  - type: table
    name: Grouped
    groupBy:
      property: tags
      direction: ASC
    order:
      - file.name
      - formula.name_length
    summaries:
      formula.name_length: Sum
