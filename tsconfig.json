{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"types": ["bun"],
		"lib": ["ESNext", "DOM", "DOM.Iterable"]
	},
	"include": ["capture/**/*.ts"]
}
