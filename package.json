{
	"name": "miami-wind-obsidian-theme",
	"private": true,
	"type": "module",
	"scripts": {
		"capture:extract-app-css": "bun capture/scripts/extract-app-css.ts",
		"capture:checklist": "bun capture/scripts/build-checklist.ts",
		"capture:run": "bun capture/scripts/capture.ts",
		"lint": "biome check .",
		"fmt": "biome check --write scripts test",
		"typecheck": "tsc --noEmit",
		"check": "biome check capture/scripts scripts test workbench/compare && tsc --noEmit && bun run test && bun run check:css && bun run lint:css",
		"capture:variants": "bun capture/scripts/variants.ts",
		"capture:coverage": "bun capture/scripts/coverage.ts",
		"build": "bun scripts/build.ts",
		"check:css": "bun scripts/check-css.ts",
		"compare": "bun workbench/compare/cli.ts",
		"test": "playwright install chromium && vitest run",
		"lint:css": "bun scripts/lint-css.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.8",
		"@bramus/specificity": "^2.4.3",
		"@electron/asar": "^4.3.2",
		"@stylistic/stylelint-plugin": "6.0.1",
		"@types/bun": "^1.4.5",
		"@types/pngjs": "^6.0.5",
		"@types/postcss-import": "^14.0.3",
		"mdn-data": "2.27.1",
		"pixelmatch": "^8.0.0",
		"playwright": "^1.65.1",
		"pngjs": "^7.0.0",
		"postcss": "^8.5.33",
		"postcss-import": "^17.0.1",
		"postcss-mixins": "^12.1.2",
		"postcss-nested": "^9.0.1",
		"postcss-selector-parser": "^7.2.1",
		"stylelint": "18.1.0",
		"stylelint-config-obsidianmd": "0.1.0",
		"stylelint-order": "8.1.3",
		"typescript": "^7.0.2",
		"vitest": "^5.1.1"
	}
}
